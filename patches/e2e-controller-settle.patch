+// waitForControllerSettled waits until the deployment runs only Ready pods of its
+// current template, none terminating, and no unexpired leader lease is held by
+// one of its former pods. A terminating controller pod still serves CSI calls and
+// leaves half-done work behind when it is killed.
+func waitForControllerSettled(c kubernetes.Interface, name, ns string, timeout int) error {
+	t := time.Duration(timeout) * time.Minute
+	err := wait.PollUntilContextTimeout(context.TODO(), poll, t, true, func(ctx context.Context) (bool, error) {
+		current, err := currentControllerPods(ctx, c, name, ns)
+		if err != nil || current == nil {
+			return false, ignoreRetryable(err)
+		}
+		holder, err := formerPodLeaseHolder(ctx, c, name, ns, current)
+		if err != nil || holder != "" {
+			return false, ignoreRetryable(err)
+		}
+
+		return true, nil
+	})
+	if err != nil {
+		return fmt.Errorf("deployment %s/%s did not settle: %w", ns, name, err)
+	}
+	framework.Logf("deployment %s/%s settled", ns, name)
+
+	return nil
+}
+
+func ignoreRetryable(err error) error {
+	if err != nil && isRetryableAPIError(err) {
+		return nil
+	}
+
+	return err
+}
+
+// currentControllerPods returns the names of the deployment's pods, as leader election
+// holder identities spell them, or nil while its rollout is not complete.
+func currentControllerPods(ctx context.Context, c kubernetes.Interface, name, ns string) ([]string, error) {
+	d, err := c.AppsV1().Deployments(ns).Get(ctx, name, metav1.GetOptions{})
+	if err != nil {
+		return nil, err
+	}
+	want := int32(1)
+	if d.Spec.Replicas != nil {
+		want = *d.Spec.Replicas
+	}
+	s := d.Status
+	if s.ObservedGeneration < d.Generation || s.UpdatedReplicas != want || s.Replicas != want || s.ReadyReplicas != want {
+		framework.Logf("deployment %s/%s: rollout in progress (generation %d/%d, replicas %d/%d/%d, want %d)",
+			ns, name, s.ObservedGeneration, d.Generation, s.Replicas, s.UpdatedReplicas, s.ReadyReplicas, want)
+
+		return nil, nil
+	}
+
+	pods, err := c.CoreV1().Pods(ns).List(ctx, metav1.ListOptions{
+		LabelSelector: metav1.FormatLabelSelector(d.Spec.Selector),
+	})
+	if err != nil {
+		return nil, err
+	}
+	current := make([]string, 0, len(pods.Items))
+	for i := range pods.Items {
+		p := &pods.Items[i]
+		if p.DeletionTimestamp != nil || !isPodConditionTrue(p, v1.PodReady) {
+			framework.Logf("deployment %s/%s: pod %s terminating or not ready", ns, name, p.Name)
+
+			return nil, nil
+		}
+		current = append(current, strings.ReplaceAll(p.Name, ".", "-"))
+	}
+	if int32(len(current)) != want {
+		framework.Logf("deployment %s/%s: %d pods, want %d", ns, name, len(current), want)
+
+		return nil, nil
+	}
+
+	return current, nil
+}
+
+// formerPodLeaseHolder returns a former pod of the deployment that still holds an
+// unexpired lease, or "". An expired lease binds nobody; a current pod takes it on demand.
+func formerPodLeaseHolder(
+	ctx context.Context,
+	c kubernetes.Interface,
+	name, ns string,
+	current []string,
+) (string, error) {
+	leases, err := c.CoordinationV1().Leases(ns).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return "", err
+	}
+	prefix := strings.ReplaceAll(name, ".", "-") + "-"
+	now := time.Now()
+	for i := range leases.Items {
+		l := &leases.Items[i].Spec
+		if l.HolderIdentity == nil || !strings.HasPrefix(*l.HolderIdentity, prefix) {
+			continue
+		}
+		holder := *l.HolderIdentity
+		if slices.ContainsFunc(current, func(p string) bool { return strings.HasPrefix(holder, p) }) {
+			continue
+		}
+		if l.RenewTime != nil && l.LeaseDurationSeconds != nil &&
+			now.After(l.RenewTime.Add(time.Duration(*l.LeaseDurationSeconds)*time.Second)) {
+			continue
+		}
+		framework.Logf("deployment %s/%s: lease %s still held by former pod %q", ns, name, leases.Items[i].Name, holder)
+
+		return holder, nil
+	}
+
+	return "", nil
+}
+
+func isPodConditionTrue(p *v1.Pod, t v1.PodConditionType) bool {
+	for i := range p.Status.Conditions {
+		if p.Status.Conditions[i].Type == t {
+			return p.Status.Conditions[i].Status == v1.ConditionTrue
+		}
+	}
+
+	return false
+}
+
+// ensureKMSConfigMap recreates the KMS configmap that the operator-deployed plugins
+// mount. deleteVault removes it, and without it restarted plugin pods never start.
+func ensureKMSConfigMap(c kubernetes.Interface, ns string) error {
+	cm := &v1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{Name: "ceph-csi-encryption-kms-config", Namespace: ns},
+		Data:       map[string]string{"config.json": "{}"},
+	}
+	_, err := c.CoreV1().ConfigMaps(ns).Create(context.TODO(), cm, metav1.CreateOptions{})
+	if err != nil && !apierrs.IsAlreadyExists(err) {
+		return fmt.Errorf("failed to create KMS configmap: %w", err)
+	}
+
+	return nil
+}
